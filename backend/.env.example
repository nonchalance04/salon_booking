NODE_ENV=development
# Optional Gemini consultation. Credentials stay on the backend.
CHATBOT_PROVIDER=guided
GEMINI_API_KEY=
GEMINI_MODEL=
CHATBOT_TIMEOUT_MS=15000
PORT=3000
HOST=127.0.0.1
SALON_TIMEZONE=Asia/Manila
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax
DATABASE_URL="postgresql://admin:admin@localhost:5432/salon_dev?schema=public"
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=13417ad18d543621a56307011d1f2c4e5bbad488cb3013bb6fe3e5cf28cc0c71
# Development seed only; supply your own credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CASHIER_EMAIL=
SEED_CASHIER_PASSWORD=
# Dedicated local/CI test server with CREATEDB permission. Never an application database.
# TEST_DATABASE_ADMIN_URL="postgresql://USER:PASSWORD@localhost:5432/postgres"
# Online payments are disabled until a provider is configured.
PAYMENT_PROVIDER=disabled
# Development only: set PAYMENT_PROVIDER=test and supply a separate random secret.
# Test payments are rejected in production; no real money is collected.
PAYMENT_TEST_SECRET=
# PayMongo GCash Hosted Checkout. Use sk_test_... in development, sk_live_... in production.
# Set PAYMENT_PROVIDER=paymongo only after filling these values locally.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_RETURN_URL=
# Notification delivery is opt-in for each channel. Test providers send nothing.
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_SMS_PROVIDER=disabled
# Gmail: enable 2-Step Verification and generate a Google App Password.
# Set NOTIFICATION_EMAIL_PROVIDER=gmail and use GMAIL_USER as the FROM address.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=
NOTIFICATION_LEASE_MS=60000
NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=60000
NOTIFICATION_POLL_MS=5000
# SMS policy all only: one reminder per confirmed schedule revision; 0 disables.
# Email reminders are included in the combined paid-booking confirmation.
NOTIFICATION_REMINDER_HOURS=24

# TextBee Android SMS gateway: credentials stay on the backend.
# Enable appointment OTP independently from routine SMS notifications.
APPOINTMENT_OTP_PROVIDER=disabled
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Separate random secret of at least 32 characters for OTP hashing.
APPOINTMENT_OTP_SECRET=
# Optional: set NOTIFICATION_SMS_PROVIDER=textbee for existing SMS notifications.

# Minimal: one combined payment/confirmation SMS; OTP on request; no routine SMS reminders/completion/payment notices.
NOTIFICATION_SMS_POLICY=minimal
# Customer-reachable frontend origin, also listed in TRUSTED_ORIGINS. Used for appointment links in confirmation emails.
PUBLIC_SITE_URL=

# Appointment access by email, independent of routine email notifications.
# Set to gmail with GMAIL_USER, GMAIL_APP_PASSWORD, matching NOTIFICATION_EMAIL_FROM,
# and APPOINTMENT_OTP_SECRET (at least 32 characters).
APPOINTMENT_EMAIL_OTP_PROVIDER=disabled
