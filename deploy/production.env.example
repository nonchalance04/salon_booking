NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://salon:REPLACE_PASSWORD@127.0.0.1:5432/salon
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
TRUSTED_ORIGINS=https://salon.example.com
COOKIE_SAME_SITE=lax
SALON_TIMEZONE=Asia/Manila
# Enable each selected provider only after its release acceptance.
PAYMENT_PROVIDER=disabled
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_SMS_PROVIDER=disabled
NOTIFICATION_REMINDER_HOURS=24
# PayMongo: PAYMENT_PROVIDER=paymongo, PAYMONGO_SECRET_KEY=sk_live_...
# PAYMONGO_WEBHOOK_SECRET=...
# PAYMONGO_RETURN_URL=https://salon.example.com/booking-confirmed
# Email: NOTIFICATION_EMAIL_PROVIDER=gmail
# GMAIL_USER=your-salon@gmail.com
# GMAIL_APP_PASSWORD=...
# NOTIFICATION_EMAIL_FROM=your-salon@gmail.com
# SMS: NOTIFICATION_SMS_PROVIDER=philsms
# PHILSMS_API_TOKEN=...
# PHILSMS_SENDER_ID=...

# TextBee Android SMS gateway: credentials stay on the backend.
# Enable appointment OTP independently from routine SMS notifications.
APPOINTMENT_OTP_PROVIDER=disabled
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Separate random secret of at least 32 characters for OTP hashing.
APPOINTMENT_OTP_SECRET=
# Optional: set NOTIFICATION_SMS_PROVIDER=textbee for existing SMS notifications.

# Minimal: one combined payment/confirmation SMS; OTP on request; no routine SMS reminders/completion/payment notices.
NOTIFICATION_SMS_POLICY=minimal
# Customer-reachable frontend origin, also listed in TRUSTED_ORIGINS. Required for SMS private links.
PUBLIC_SITE_URL=

# Appointment access by email, independent of routine email notifications.
# Set to gmail with GMAIL_USER, GMAIL_APP_PASSWORD, matching NOTIFICATION_EMAIL_FROM,
# and APPOINTMENT_OTP_SECRET (at least 32 characters).
APPOINTMENT_EMAIL_OTP_PROVIDER=disabled
